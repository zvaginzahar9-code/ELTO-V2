# зависимости и сборка
# (search.json, sitemap.xml и robots.txt собираются из данных при каждом запуске)
public/data/search.json
public/sitemap.xml
public/robots.txt
node_modules/
dist/
*.tsbuildinfo

# кэш инструментов
.vite/
.cache/
coverage/

# исходники ассетов: сотни мегабайт, из которых уже собрано public/
_source/photos/
media-src/

# рабочие каталоги: съёмка сайта и выгрузки генератора сцен
.shots/
.flow/

# локальные скрипты генерации: привязаны к профилю браузера этой машины
scripts/flow/

# окружение
.env
.env.*
!.env.example

# мусор системы и редакторов
*.log
*.bak
*.tmp
*.swp
.DS_Store
Thumbs.db

# рабочие материалы: скриншоты ошибок и видео-референс дизайна
/косяки с лентой/
/референс сайта .mp4
*.mp4
!public/**/*.mp4
