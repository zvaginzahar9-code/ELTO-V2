{
  "name": "elto",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prepare:data && vite",
    "build": "npm run prepare:data && tsc -b && vite build",
    "prepare:data": "node scripts/build-search.mjs && node scripts/build-sitemap.mjs",
    "preview": "vite preview",
    "data": "node scripts/build-data.mjs",
    "images": "node scripts/build-images.mjs",
    "media": "node scripts/process-media.mjs",
    "fonts": "node scripts/build-fonts.mjs",
    "shoot": "node scripts/shoot.mjs",
    "lint": "eslint .",
    "typecheck": "tsc -b",
    "check": "npm run lint && npm run typecheck && npm run build",
    "qa:responsive": "node scripts/responsive.mjs",
    "qa:overlap": "node scripts/overlap.mjs",
    "qa:a11y": "node scripts/a11y.mjs && node scripts/a11y-structure.mjs",
    "qa:perf": "node scripts/perf.mjs",
    "qa": "npm run qa:responsive && npm run qa:overlap && npm run qa:a11y && npm run qa:scroll",
    "qa:scroll": "node scripts/scroll-perf.mjs",
    "qa:vitals": "node scripts/vitals.mjs",
    "qa:lighthouse": "node scripts/lighthouse.mjs",
    "qa:headers": "node scripts/headers-check.mjs"
  },
  "dependencies": {
    "animejs": "^4.5.0",
    "lenis": "^1.3.26",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.10.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.12.0",
    "lighthouse": "^13.5.0",
    "playwright-core": "^1.63.0",
    "sharp": "^0.35.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0"
  }
}
